# Template .env untuk server production.
#
# Salin ke .env di server, lalu isi bagian bertanda ISI_INI.
# Baris yang tidak ada di sini memakai default Laravel dan tidak perlu diubah.
#
# Perbedaan dari .env local dijelaskan di DEPLOYMENT.md.

APP_NAME="ParkOps"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ISI_INI

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ISI_INI
DB_USERNAME=ISI_INI
DB_PASSWORD=ISI_INI

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookie sesi hanya dikirim lewat HTTPS. Baris ini TIDAK ada di .env local.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Aplikasi belum mengirim email, jadi log aman dibiarkan.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@ISI_INI"
MAIL_FROM_NAME="${APP_NAME}"

# ── ParkOps domain defaults (spec §12, §22, §23, §34) ──────────────────────────
PARKOPS_DEFAULT_RADIUS_METER=10
PARKOPS_DEFAULT_GPS_ACCURACY_LIMIT=20
PARKOPS_DEFAULT_LATE_TOLERANCE_MINUTES=15
PARKOPS_ATTENDANCE_PHOTO_MAX_KB=5120
PARKOPS_CHECKIN_EARLY_WINDOW_MINUTES=240
PARKOPS_CHECKIN_LATE_WINDOW_MINUTES=240
PARKOPS_CHECKOUT_EARLY_WINDOW_MINUTES=240
PARKOPS_CHECKOUT_GRACE_MINUTES=420

# Geofence tidak perlu diisi: APP_ENV=production sudah membuatnya ditegakkan.

# Mencegah DemoDataSeeder ikut jalan kalau db:seed terlanjur dipanggil tanpa
# --class. Data contoh tidak boleh masuk ke database production.
PARKOPS_SEED_DEMO=false

# ── Reverse geocoding (alamat GPS pada absensi) ─────────────────────────────
# Nominatim mensyaratkan User-Agent berisi kontak yang nyata; tanpa itu
# permintaan bisa diblokir saat trafik naik.
PARKOPS_GEOCODING_ENABLED=true
PARKOPS_GEOCODING_LANGUAGE=id
PARKOPS_GEOCODING_USER_AGENT="ParkOps/1.0 (ISI_INI@email.anda)"

# ── Aplikasi mobile (ParkOps-PARKIR-MOBILE) ────────────────────────────────────
# Masa berlaku token Sanctum dalam menit (default 30 hari). Jangan diisi 0 di
# production: token tanpa kedaluwarsa hanya bisa dicabut secara manual.
SANCTUM_EXPIRATION_MINUTES=43200

# Token yang sudah lewat masa berlaku tetap tersimpan sampai dibersihkan.
# Jadwalkan pembersihannya, misalnya harian:
#   php artisan sanctum:prune-expired --hours=24
